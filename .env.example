# Copy to .env (gitignored) and fill in. Never commit .env.
MODEL_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1

# Spending cap (upgrade_gate/spend.py). Every real call is checked against it before it is sent.
# Lifetime limit for this machine plus the canary. Anything above 100 is clamped to 100.
MAX_TOTAL_SPEND_USD=90
# Part of that limit set aside for the GitHub canary. Set to 0 if you never turn the canary on.
CANARY_BUDGET_USD=15

# Optional: hosted Muse Spark Open as a cheap open-weights judge (Baseten / Modal / Fireworks)
OPEN_JUDGE_BASE=
OPEN_JUDGE_KEY=
OPEN_JUDGE_MODEL=
