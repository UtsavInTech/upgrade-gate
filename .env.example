# Copy to .env (gitignored) and fill in. Never commit .env.

# Option A — OpenRouter (no Meta billing setup needed). Same Muse models, served by Meta.
MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Option B — Meta Model API directly
# MODEL_PROVIDER=meta
# MODEL_API_KEY=
# MODEL_API_BASE=https://api.meta.ai/v1

# Optional: a different host for the open-weights judge (with OpenRouter, the 'open' and
# 'glimmer' presets already work without these)
OPEN_JUDGE_BASE=
OPEN_JUDGE_KEY=
OPEN_JUDGE_MODEL=
